# Build output (cargo, and the versioned exe the release workflow copies)
target/
build/
# Downloaded or copied binaries (the release exe, WebView2Loader.dll, debug symbols)
*.exe
*.dll
*.pdb

# Editors and OS files
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.local.json

# Local data and secrets: never commit these
*.log
*.bak*
.env
.env.*
settings.json
last_usage.json
fetch_state.json
notified.json
history.json
login_result.json
.credentials.json
*.pem
*.key
*.p12
*.pfx
